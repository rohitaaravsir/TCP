# ============================================================
# TCP — Telegram Commerce Platform
# .gitignore
# ============================================================

# --- Python ---
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pdb
*.egg
*.egg-info/
dist/
build/
*.so
.Python

# --- Virtual Environment ---
.venv/
venv/
env/
ENV/

# --- Environment & Secrets ---
.env
.env.*
!.env.example

# --- Logs ---
logs/
*.log

# --- Storage (temporary files) ---
storage/screenshots/
storage/cache/
storage/downloads/
storage/processing/

# --- Testing ---
.pytest_cache/
.coverage
htmlcov/
.tox/

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- OS ---
.DS_Store
Thumbs.db
desktop.ini

# --- Supabase ---
supabase/.branches/
supabase/.temp/

# --- Misc ---
*.bak
*.tmp
