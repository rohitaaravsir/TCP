# ============================================================
# TCP — Telegram Commerce Platform
# Environment Variables Template
#
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ============================================================

# -----------------------------------------------------------
# TELEGRAM BOT
# -----------------------------------------------------------

# Your Telegram Bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# JSON array of authorized admin Telegram user IDs
ADMIN_IDS=[123456789]

# -----------------------------------------------------------
# SUPABASE
# -----------------------------------------------------------

# Supabase project URL
SUPABASE_URL=https://your-project.supabase.co

# Supabase anonymous (public) key
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase service role key (privileged — keep secret)
SUPABASE_SERVICE_KEY=your_supabase_service_key_here

# -----------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------

# Runtime environment: development | staging | production
APP_ENV=development

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Log directory (relative or absolute path)
LOG_DIR=logs

# -----------------------------------------------------------
# HEALTH CHECK SERVER
# -----------------------------------------------------------

# Host for the health check HTTP server
HEALTH_HOST=0.0.0.0

# Port for the health check HTTP server
HEALTH_PORT=8080

# -----------------------------------------------------------
# FEATURE FLAGS (future use)
# -----------------------------------------------------------

# Enable/disable AI features
FEATURE_AI_ENABLED=false

# Enable/disable OCR payment verification
FEATURE_OCR_ENABLED=false

# Enable/disable human support system
FEATURE_SUPPORT_ENABLED=false

# -----------------------------------------------------------
# AI ASSISTANT (Gemini)
# -----------------------------------------------------------

# Google Gemini API key
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model to use for support chat
GEMINI_MODEL=gemini-2.5-flash

# -----------------------------------------------------------
# OCR PAYMENT VERIFICATION (Sprint 7)
# -----------------------------------------------------------

# Your merchant/bank account name that appears on payment receipts
# Example: If your GPay/PhonePe shows "Rohit Kumar" — put that here
OCR_RECEIVER_NAME=Your Name Here

# Your UPI ID (soft check — optional but recommended)
# Example: rohit@okaxis
OCR_UPI_ID=yourname@upi

# Confidence threshold for auto-approval (0.0 to 1.0)
# 0.90 = 90% — payments scoring ≥90% are auto-approved
OCR_AUTO_APPROVE_THRESHOLD=0.90

# Time freshness bonus window (in minutes)
# Screenshot time within this window gets the freshness bonus (+5%)
OCR_TIME_FRESHNESS_MINUTES=30

# Hard block threshold (in hours)
# Screenshots older than this are ALWAYS sent to manual review
OCR_TIME_HARD_BLOCK_HOURS=2
